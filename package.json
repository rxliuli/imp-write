{
  "name": "imp-write",
  "description": "AI fix & rewrite in any textbox — type /fix at the end and pause",
  "private": true,
  "version": "0.0.12",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:safari": "wxt build -b safari",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "is-ci && pnpm exec playwright install || echo 'Not in CI' && vitest run",
    "e2e": "pnpm build && playwright test",
    "init-project": "vite-node lib/build/init.ts"
  },
  "dependencies": {
    "@extport/sdk": "^0.0.5",
    "@rxliuli/imp-credits-sdk": "^0.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@webext-core/messaging": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@extport/wxt": "^0.0.9",
    "@hono/node-server": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.5",
    "@wxt-dev/module-react": "^1.2.2",
    "hono": "^4.12.15",
    "is-ci": "^4.1.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.5",
    "vitest-browser-react": "^2.2.0",
    "wxt": "^0.21.4",
    "zx": "^8.8.5"
  },
  "pnpm": {
    "overrides": {
      "wxt>vite": "^8.0.0"
    }
